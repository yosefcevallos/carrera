# Supabase project (Settings → API). The service role key is server-only; never ship it to a browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Program and cluster
PROGRAM_ID=GH45ANLzg1t6rNnaoNqE39rN1rKGXFQXPZnNxvbhUmYw
RPC_URL=https://api.devnet.solana.com

# Event source: "helius" (webhook receiver on PORT) or "poll" (RPC polling from CURSOR_PATH)
SOURCE=poll
PORT=8790
CURSOR_PATH=.cursor.json
POLL_INTERVAL_MS=15000

# Helius webhook: set the same value as the webhook's Authorization header
HELIUS_WEBHOOK_SECRET=

# Keeper status server; leave empty to skip ops snapshots
KEEPER_URL=http://127.0.0.1:8787
KEEPER_INTERVAL_MS=60000
