<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carrera.indexer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--env-file=__HOME__/.config/carrera/indexer.env</string>
    <string>dist/main.js</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.config/carrera/indexer-runtime</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/carrera/indexer.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/carrera/indexer.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__NODE_DIR__:__HOME__/.local/share/solana/install/releases/3.1.1/solana-release/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
